# --- Azure AD / Microsoft Graph app-only auth (client credentials flow) ---
# Pide a tu equipo de IAM/Cloud Identity un app registration con permiso
# de aplicacion "Sites.Selected" (preferido) o "Sites.Read.All" + "Files.Read.All",
# consentido por un admin. Con Sites.Selected, ademas necesitas que un admin
# del sitio le otorgue acceso a ESTE sitio especifico via POST /sites/{id}/permissions.
AZURE_TENANT_ID=
AZURE_CLIENT_ID=
AZURE_CLIENT_SECRET=
GRAPH_SCOPE=https://graph.microsoft.com/.default

# --- Ubicacion del workbook en SharePoint (ya resueltos para este proyecto) ---
SHAREPOINT_SITE_ID=teams.wal-mart.com,ca1a6564-a510-4672-8abf-36954dfc4281,fbdfb253-f7c0-4797-a5fd-342be432de88
SHAREPOINT_DRIVE_ID=b!ZGUayhClckaKvzaVTfxCgVOy3_vA95dHpf00K-Qy3ogF32dXbXL0Q4Ky0-5oSijM
WORKBOOK_ITEM_ID=01I34YLLA2KH24F5PKQRE3REKDUPDSAUCV

# --- Sync ---
POLL_INTERVAL_SECONDS=60

# --- App ---
DASHBOARD_DB_PATH=dashboard.db
